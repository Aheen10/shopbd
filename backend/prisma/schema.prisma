generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String?  @unique
  password  String
  phone     String?  @unique
  role      String   @default("user")
  createdAt DateTime @default(now())
  orders    Order[]
  reviews   Review[]
  wishlist  Wishlist[]
}

model Product {
  id             Int         @id @default(autoincrement())
  name           String
  description    String?
  price          Float
  oldPrice       Float?
  category       String
  emoji          String      @default("📦")
  stock          Int         @default(0)
  imageUrl       String?
  images         String?     @db.Text
  specifications String?     @db.Text
  createdAt      DateTime    @default(now())
  orderItems     OrderItem[]
  reviews        Review[]
  wishlistedBy Wishlist[]
}

model Order {
  id              Int         @id @default(autoincrement())
  uniqueId        String?     @unique
  userId          Int
  user            User        @relation(fields: [userId], references: [id])
  total           Float
  status          String      @default("pending")
  deliveryPhone   String?
  deliveryAddress String?     @db.Text
  createdAt       DateTime    @default(now())
  orderItems      OrderItem[]
  paymentStatus String @default("cod_pending")
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id])
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}

model Review {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  rating    Int
  comment   String?  @db.Text
  createdAt DateTime @default(now())
}

model Wishlist {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model SiteSettings {
  id           Int    @id @default(autoincrement())
  banners      String @db.Text
  trustBadges  String @db.Text
  shopName     String @default("ShopBD")
  heroTitle    String @default("Everything for Your Home")
  heroSubtitle String @default("Kitchen, bedroom, bathroom & more.")
  shippingPolicy  String? @db.Text
  returnPolicy    String? @db.Text
  insideDhakaCharge  Float @default(60)
  outsideDhakaCharge Float @default(120)
  freeDeliveryAbove  Float @default(10000)
}